{
  // Cloudflare Workers の設定ファイル
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "geinin-life",
  "main": "src/worker.js",
  "compatibility_date": "2026-06-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "ai": { "binding": "AI" },
  "durable_objects": {
    "bindings": [
      { "name": "HOF", "class_name": "HallOfFame" },
      { "name": "FEEDBACK", "class_name": "FeedbackBox" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["HallOfFame"] },
    { "tag": "v2", "new_sqlite_classes": ["FeedbackBox"] }
  ],
  // 管理画面のパスワード ADMIN_PASSWORD は、Cloudflare の「Variables and Secrets」に Secret として登録する
  "observability": { "enabled": true }
}

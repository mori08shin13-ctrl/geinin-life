{
  // Cloudflare Workers の設定ファイル
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "geinin-life",
  "main": "src/worker.js",
  "compatibility_date": "2026-06-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "ai": { "binding": "AI" },
  "durable_objects": {
    "bindings": [{ "name": "HOF", "class_name": "HallOfFame" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["HallOfFame"] }],
  "observability": { "enabled": true }
}
